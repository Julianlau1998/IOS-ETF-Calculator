    "%lld distributions are imported too.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Ausschüttungen werden ebenfalls importiert."
          }
        }
      }
    },
    "%lld of %lld free scenarios used. Premium saves unlimited scenarios.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld von %lld kostenlosen Szenarien belegt. Mit Premium sicherst du unbegrenzt viele."
          }
        }
      }
    },
    "^[%lld Month](inflect: true)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "^[%lld Monat](inflect: true)"
