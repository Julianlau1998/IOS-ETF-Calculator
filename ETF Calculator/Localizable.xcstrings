    "Calculated from your transactions. Values are based on the last purchase prices — update prices afterwards for current values.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus deinen Transaktionen berechnet. Die Werte basieren auf den letzten Kaufkursen – aktualisiere danach die Kurse für aktuelle Werte."
          }
        }
      }
    },
    "Calculates how much you need to save each month to reach a target amount.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Berechnet, wie viel du monatlich sparen musst, um einen Zielbetrag zu erreichen."
