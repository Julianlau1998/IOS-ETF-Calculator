{
  "sourceLanguage": "en",
  "strings": {
    "“Automatic” gives every tab its own color. Pick a theme to use one color throughout the app.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Automatisch“ gibt jedem Tab eine eigene Farbe. Wähle ein Thema, um eine Farbe in der ganzen App zu nutzen."
          }
        }
      }
    },
    "“In Today's Money” shows the final value adjusted for %@ annual inflation.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Heutige Kaufkraft“ zeigt den Endwert bereinigt um %@ jährliche Inflation."
          }
        }
      }
    },
    "(%@)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "(%@)"
          }
        }
      }
    },
    "%@ (Copy)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (Kopie)"
          }
        }
      }
    },
    "%@ × %@": {
      "localizations": {
        "de": {
