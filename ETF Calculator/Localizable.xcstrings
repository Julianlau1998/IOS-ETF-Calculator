          "stringUnit": {
            "state": "translated",
            "value": "%@ hinter Plan"
          }
        }
      }
    },
    "%@ is your most expensive position (%@). Cheaper alternatives often exist.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist deine teuerste Position (%@). Oft gibt es günstigere Alternativen."
          }
        }
      }
    },
