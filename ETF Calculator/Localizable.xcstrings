    },
    "^[%lld Year](inflect: true)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "^[%lld Jahr](inflect: true)"
          }
        }
      }
    },
    "^[%lld Year](inflect: true), ^[%lld Month](inflect: true)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "^[%lld Jahr](inflect: true), ^[%lld Monat](inflect: true)"
          }
        }
      }
    },
    "^[%lld Year](inflect: true), including lost returns": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "^[%lld Jahr](inflect: true), inklusive entgangener Rendite"
